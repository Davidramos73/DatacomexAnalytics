# --- provider: anthropic (default) ---
ANTHROPIC_API_KEY=

# --- provider: openrouter (OpenAI-compatible aggregator) ---
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- provider: deepseek (DeepSeek's own OpenAI-compatible endpoint) ---
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional model overrides. Defaults:
#   anthropic  -> claude-opus-5
#   openrouter -> deepseek/deepseek-v4-pro-0813
#   deepseek   -> deepseek-v4-pro   (also: deepseek-v4-flash)
# LLM_MODEL=
# DATA_AGENT_MODEL=

# --- auth (Google login) ---
# AUTH_ENABLED=false leaves everything open (dev). Set true in production.
AUTH_ENABLED=false
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# SESSION_SECRET=            # openssl rand -hex 32
# ALLOWED_EMAILS=you@example.com,teammate@example.com
# SESSION_MAX_AGE=1209600    # 14 days
# AUTH_DB_PATH=/app/data/auth.sqlite   # mount a volume here in prod
